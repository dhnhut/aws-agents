{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "WanderTravel",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "WanderTravel"
  },
  "runtimes": [
    {
      "name": "SupportBot",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/SupportBot/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    }
  ],
  "memories": [
    {
      "name": "WandeBot",
      "eventExpiryDuration": 30,
      "strategies": []
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "wanderbot-gateway",
      "protocolType": "None",
      "description": "Gateway for wanderbot-gateway",
      "targets": [
        {
          "name": "get-booking-tools",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "arn:aws:lambda:us-east-1:566068566473:function:get_booking",
            "toolSchemaFile": "app/SupportBot/lambda/get_booking.json"
          }
        }
      ],
      "authorizerType": "NONE",
      "enableSemanticSearch": true,
      "exceptionLevel": "NONE"
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}